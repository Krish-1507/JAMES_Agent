# =============================================================================
# JAMES — Just A Modular Executive System (your open-source JARVIS)
# Copy this file to `.env` and fill in the values you need.
# You only need the API key for the provider you choose in LLM_PROVIDER.
# Everything is optional except the provider you actually use.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM PROVIDER SELECTION
# One of: openai | anthropic | gemini | openrouter | groq | custom
# The model id is fully editable so you can pick whatever suits you best.
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Sampling / generation tuning
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# -----------------------------------------------------------------------------
# PROVIDER API KEYS
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# CUSTOM / OPENAI-COMPATIBLE ENDPOINT
# Use this for self-hosted models (Ollama, LM Studio, vLLM, Together, etc.)
# Set LLM_PROVIDER=custom and point CUSTOM_BASE_URL at the OpenAI-compatible API.
# -----------------------------------------------------------------------------
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=

# Optional OpenRouter extras
OPENROUTER_HTTP_REFERER=https://github.com/yourname/james
OPENROUTER_SITE_NAME=JAMES

# -----------------------------------------------------------------------------
# VOICE / SPEECH
# STT (speech-to-text): whisper_local | whisper_api | google | none
# TTS (text-to-speech): pyttsx3 | openai | elevenlabs | edge | none
# Set VOICE_ENABLED=false to run in text-only mode.
# -----------------------------------------------------------------------------
VOICE_ENABLED=true
STT_PROVIDER=whisper_local
TTS_PROVIDER=pyttsx3

# Whisper API (only needed if STT_PROVIDER=whisper_api)
WHISPER_API_KEY=

# ElevenLabs (only needed if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Microphone device index (leave blank to use the system default)
MIC_DEVICE_INDEX=

# -----------------------------------------------------------------------------
# ASSISTANT PERSONALITY & BEHAVIOUR
# -----------------------------------------------------------------------------
ASSISTANT_NAME=JAMES
USER_NAME=User
WAKE_WORD=jarvis
SYSTEM_PROMPT=

# Where JAMES keeps its working memory / generated files
WORKSPACE_DIR=./workspace
LOG_LEVEL=INFO

# Where JAMES keeps its working memory / generated files
WORKSPACE_DIR=./workspace
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# SAFETY & CAPABILITY TIERS
# CONFIRM_DANGEROUS_ACTIONS: prompt before destructive tools run.
# JAMES_MODE: "full" enables shell/delete/app tools; "standard" blocks them.
# DRY_RUN: simulate dangerous actions instead of executing them (audit only).
# -----------------------------------------------------------------------------
CONFIRM_DANGEROUS_ACTIONS=true
JAMES_MODE=full
DRY_RUN=false
AUDIT_LOG=./workspace/james_audit.log

# -----------------------------------------------------------------------------
# MEMORY / RAG
# JAMES remembers facts across sessions (keyword search, or semantic if
# sentence-transformers is installed). Stored as a local JSONL file.
# -----------------------------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_FILE=./workspace/memory.jsonl

# -----------------------------------------------------------------------------
# BROWSER AUTOMATION (Playwright)
# headless=true runs without a visible window; set false to watch it work.
# -----------------------------------------------------------------------------
BROWSER_HEADLESS=true

# -----------------------------------------------------------------------------
# WAKE WORD ENGINE
# "always"  = continuous mic listening (default, no extra deps)
# "porcupine" = low-power wake word via Picovoice (needs PORCUPINE_KEY)
# "none"    = disabled (use --text mode)
# -----------------------------------------------------------------------------
WAKE_ENGINE=always
PORCUPINE_KEY=

# -----------------------------------------------------------------------------
# MCP SERVERS (optional, needs: pip install mcp)
# Connect any Model Context Protocol server; its tools appear in JAMES automatically.
# Provide a JSON array via MCP_SERVERS, or a mcp.json file at the project root.
# Example (stdio):  [{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","./workspace"]}]
# Example (http):   [{"name":"remote","transport":"http","url":"http://localhost:8000/mcp"}]
# -----------------------------------------------------------------------------
MCP_SERVERS=

# -----------------------------------------------------------------------------
# SKILL FORGE (self-improvement)
# After a complex multi-step task JAMES suggests saving it as a reusable skill.
# Skills are persisted to ./plugins/ and hot-loaded into the live session.
# -----------------------------------------------------------------------------
SKILL_AUTOSUGGEST=true
