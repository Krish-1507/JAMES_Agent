# =============================================================================
# JAMES — Just A Modular Executive System (your open-source JARVIS)
# Copy this file to `.env` and fill in the values you need.
# You only need the API key for the provider you choose in LLM_PROVIDER.
# Everything is optional except the provider you actually use.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM PROVIDER SELECTION
# One of: openai | anthropic | gemini | openrouter | groq | mistral | xai
#         | deepseek | together | cerebras | cohere | custom
# All except anthropic/gemini/custom use OpenAI-compatible endpoints.
# The model id is fully editable so you can pick whatever suits you best.
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Sampling / generation tuning
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# Failover: if the primary errors, JAMES retries these in order ("provider[:model]").
# Example: LLM_FAILOVER=anthropic:claude-3-5-sonnet-latest,groq:llama-3.3-70b-versatile
LLM_FAILOVER=

# -----------------------------------------------------------------------------
# PROVIDER API KEYS
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=

# Optional: multi-engine web search (web_search engine=auto uses these when set).
# Without keys, web_search transparently falls back to DuckDuckGo (no key needed).
TAVILY_API_KEY=
BRAVE_API_KEY=

# -----------------------------------------------------------------------------
# CUSTOM / OPENAI-COMPATIBLE ENDPOINT
# Use this for self-hosted models (Ollama, LM Studio, vLLM, Together, etc.)
# Set LLM_PROVIDER=custom and point CUSTOM_BASE_URL at the OpenAI-compatible API.
# -----------------------------------------------------------------------------
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=

# Optional OpenRouter extras
OPENROUTER_HTTP_REFERER=https://github.com/yourname/james
OPENROUTER_SITE_NAME=JAMES

# -----------------------------------------------------------------------------
# VOICE / SPEECH
# STT (speech-to-text): whisper_local | whisper_api | google | none
# TTS (text-to-speech): edge | pyttsx3 | openai | elevenlabs | none
#   edge       = free, neural, natural Microsoft voices (recommended, no key)
#   pyttsx3    = offline system voices (robotic, no network)
#   openai / elevenlabs = premium human voices (need their API key)
# Falls back edge -> pyttsx3 -> text if the optional dependency is missing.
# Set VOICE_ENABLED=false to run in text-only mode.
# -----------------------------------------------------------------------------
VOICE_ENABLED=true
STT_PROVIDER=whisper_local
TTS_PROVIDER=edge

# Whisper API (only needed if STT_PROVIDER=whisper_api)
WHISPER_API_KEY=

# ElevenLabs (only needed if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Microphone device index (leave blank to use the system default)
MIC_DEVICE_INDEX=
# Speaker device index (leave blank to use the system default)
SPEAKER_DEVICE_INDEX=

# -----------------------------------------------------------------------------
# FULL-DUPLEX VOICE (speak and listen at once, with interruption)
# DUPLEX_MODE: off | auto | gemini_live | openai_realtime | local
#   off            = turn-based voice loop (default)
#   auto           = first available of gemini_live -> openai_realtime -> local
#   gemini_live    = Gemini Live API speech-to-speech (needs GEMINI_API_KEY)
#   openai_realtime= OpenAI Realtime API (needs OPENAI_API_KEY)
#   local          = fully local: VAD + faster-whisper + edge-tts/ffmpeg streaming
#                    with mic-level barge-in (no cloud audio API)
# Duplex sessions are wake-gated (see WAKE_ENGINE below) and close after
# DUPLEX_IDLE_TIMEOUT seconds of quiet. VAD/BARGE thresholds are 0..1 RMS levels.
# -----------------------------------------------------------------------------
DUPLEX_MODE=off
DUPLEX_IDLE_TIMEOUT=30
VAD_THRESHOLD=0.02
BARGE_IN_THRESHOLD=0.03
STREAMING_STT_MODEL=small
DUPLEX_EDGE_VOICE=en-US-AriaNeural
GEMINI_LIVE_VOICE=Puck
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# -----------------------------------------------------------------------------
# ASSISTANT PERSONALITY & BEHAVIOUR
# -----------------------------------------------------------------------------
ASSISTANT_NAME=JAMES
USER_NAME=User
WAKE_WORD=jarvis
SYSTEM_PROMPT=

# Where JAMES keeps its workspace / generated files
WORKSPACE_DIR=./workspace
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# SAFETY & CAPABILITY TIERS
# CONFIRM_DANGEROUS_ACTIONS: prompt before destructive tools run.
# JAMES_MODE: "full" enables shell/delete/app tools; "standard" blocks them.
# DRY_RUN: simulate dangerous actions instead of executing them (audit only).
# -----------------------------------------------------------------------------
CONFIRM_DANGEROUS_ACTIONS=true
JAMES_MODE=standard
DRY_RUN=false
AUDIT_LOG=./workspace/james_audit.log

# -----------------------------------------------------------------------------
# AUDIT LOG INTEGRITY
# JAMES signs audit log entries with HMAC-SHA256 using this key.
# Change this to a strong random value in production to prevent tampering.
# Set to empty to disable HMAC signing (not recommended).
# -----------------------------------------------------------------------------
JAMES_AUDIT_HMAC_KEY=

# -----------------------------------------------------------------------------
# CONVERSATION ENCRYPTION
# JAMES encrypts in-memory conversation history using a key derived from this
# secret. Change this to a strong random value in production.
# Set to empty to disable encryption (not recommended).
# -----------------------------------------------------------------------------
JAMES_HISTORY_KEY=

# -----------------------------------------------------------------------------
# MEMORY / RAG (semantic)
# JAMES remembers facts across sessions. With the [memory] extra installed it
# uses sentence-transformers embeddings for true semantic recall; otherwise it
# falls back to keyword overlap. Stored as a local JSONL file.
# -----------------------------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_EMBEDDING=true
MEMORY_FILE=./workspace/memory.jsonl

# -----------------------------------------------------------------------------
# PRIVACY-CERTIFIED OFFLINE MODE
# Set OFFLINE_MODE=true to block ALL non-local network egress at the socket
# layer (DNS + TCP). Only loopback (e.g. a local Ollama at 127.0.0.1) is allowed.
# Every allowed/blocked connection is written to EGRESS_AUDIT_LOG so you can
# prove nothing left the machine. Pair with LLM_PROVIDER=custom + Ollama.
# -----------------------------------------------------------------------------
OFFLINE_MODE=false
EGRESS_AUDIT_LOG=./workspace/james_egress.log

# -----------------------------------------------------------------------------
# COMPUTER-USE (vision desktop control)
# Needs the [desktop] extra (pyautogui). VISION_MODEL overrides the model used
# for screenshot->act reasoning (e.g. a local llava model via Ollama).
# -----------------------------------------------------------------------------
VISION_MODEL=

# -----------------------------------------------------------------------------
# BROWSER AUTOMATION (Playwright)
# headless=true runs without a visible window; set false to watch it work.
# -----------------------------------------------------------------------------
BROWSER_HEADLESS=true

# -----------------------------------------------------------------------------
# WAKE WORD ENGINE
# "always"  = continuous mic listening (default, no extra deps)
# "porcupine" = low-power wake word via Picovoice (needs PORCUPINE_KEY)
# "none"    = disabled (use --text mode)
# -----------------------------------------------------------------------------
WAKE_ENGINE=always
PORCUPINE_KEY=

# -----------------------------------------------------------------------------
# MCP SERVERS (optional, needs: pip install mcp)
# Connect any Model Context Protocol server; its tools appear in JAMES automatically.
# Provide a JSON array via MCP_SERVERS, or a mcp.json file at the project root.
# Example (stdio):  [{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","./workspace"]}]
# Example (http):   [{"name":"remote","transport":"http","url":"http://localhost:8000/mcp"}]
# -----------------------------------------------------------------------------
MCP_SERVERS=

# -----------------------------------------------------------------------------
# SKILL FORGE (self-improvement)
# After a successful multi-tool task JAMES can persist it as a native @tool
# plugin (auto-generated, or via "save this as a skill called <name>"). Skills
# are written to ./plugins/ and hot-loaded into the live session + auto-discovered
# on every future startup. AUTO_SKILL controls the automatic generation.
# -----------------------------------------------------------------------------
AUTO_SKILL=false
ENABLE_TRUSTED_EXTERNAL_PLUGINS=false

# -----------------------------------------------------------------------------
# AUTONOMOUS FILE EXPLORER MANAGER
# JAMES can take 100% agentic control of the file system and organise it in the
# background. AUTO_FILE_MANAGER starts a daemon that keeps the user's main folders
# tidy on an interval (FILE_MANAGER_INTERVAL, seconds). FILE_MANAGER_SCOPES is a
# comma-separated list of locations: desktop|documents|downloads|workspace|home|whole
# or absolute paths.
# -----------------------------------------------------------------------------
AUTO_FILE_MANAGER=false
FILE_MANAGER_INTERVAL=1800
FILE_MANAGER_SCOPES=Desktop,Documents,Downloads

# -----------------------------------------------------------------------------
# PER-TOOL PERMISSIONS
# Fine-grained control over which tools are allowed or denied.
# TOOL_<name>=true/false overrides the global ALLOWED_TOOLS/DENIED_TOOLS lists.
# Alternatively, set ALLOWED_TOOLS and DENIED_TOOLS as comma-separated lists.
# When ALLOWED_TOOLS is non-empty, only those tools are permitted.
# NOTE: keep system-mutating tools OFF by default. JAMES blocks them in
# "standard" mode; TOOL_<name>=true here would silently re-allow them.
# -----------------------------------------------------------------------------
ALLOWED_TOOLS=
DENIED_TOOLS=
# TOOL_run_shell_command=false
# TOOL_open_application=false
# TOOL_delete_file=false
# TOOL_move_file=false

# -----------------------------------------------------------------------------
# WEB DASHBOARD
# Launch a browser-based dashboard with `james --web-dashboard`.
# The dashboard runs on http://127.0.0.1:8123 by default.
# -----------------------------------------------------------------------------
JAMES_DASHBOARD_PORT=8123

# -----------------------------------------------------------------------------
# CONVERSATION HISTORY
# JAMES persists conversation history to JSONL and summarizes it across sessions.
# Use `james --session <name>` (or in-loop /new, /resume) for named,
# isolated conversations stored under workspace/sessions/.
# -----------------------------------------------------------------------------
CONVERSATION_HISTORY=./workspace/conversation_history.enc
