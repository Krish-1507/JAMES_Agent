        "james.tools.web_tools",
        "james.tools.document_tools",
        "james.tools.delegate_tool",
        "james.tools.base",
        "james.tools.registry",
        "james.core.guard",
        "james.core.scheduler",
        "james.core.agent",
        "james.core.assistant",
        "james.core.personality",
        "james.core.doctor",
